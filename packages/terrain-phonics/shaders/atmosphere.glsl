// Single scattering and Beer-Lambert extinction. All distances are metres and all colors linear HDR.
// The transmittance LUT is generated by TerrainPhonics\Atmosphere; no per-frame CPU readback is needed.
uniform vec3 uSunDirection;
uniform float uSunIntensity;
uniform float uAngularRadius;
uniform vec3 uRayleigh;
uniform float uMie;
uniform float uMieAlbedo;
uniform float uMieG;
uniform float uHaze;
uniform float uExposure;
uniform vec3 uNightAmbient;
uniform float uPlanetRadius;
uniform float uAtmosphereHeight;
uniform float uRayleighHeight;
uniform float uMieHeight;
uniform sampler2D uTransmittance;
uniform vec2 uTransmittanceSize;
const float TERRAIN_PI = 3.141592653589793;

vec3 terrainNightSky(float elevation)
{
	float h = clamp(elevation, 0.0, 1.0);
	return uNightAmbient * (0.27 - 0.17 * h * (2.0 - h));
}

float terrainAtmosphereAltitude(float altitude, float mu, float distanceMeters)
{
	float radius = uPlanetRadius + altitude;
	float delta = distanceMeters * distanceMeters + 2.0 * radius * mu * distanceMeters;
	return max(0.0, altitude + delta / (sqrt(max(0.0, radius * radius + delta)) + radius));
}

float terrainAtmosphereExit(float altitude, float mu)
{
	float radius = uPlanetRadius + altitude;
	float delta = (uAtmosphereHeight - altitude) * (2.0 * uPlanetRadius + uAtmosphereHeight + altitude);
	float root = sqrt(max(0.0, radius * radius * mu * mu + delta));
	return mu >= 0.0 ? delta / max(1e-6, root + radius * mu) : root - radius * mu;
}

float terrainAtmosphereBoundary(float altitude, float mu, out bool ground)
{
	float radius = uPlanetRadius + altitude;
	float groundDelta = altitude * (2.0 * uPlanetRadius + altitude);
	float groundRoot = radius * radius * mu * mu - groundDelta;
	ground = mu < 0.0 && groundRoot >= 0.0;
	if(ground) return groundDelta / max(1e-6, -radius * mu + sqrt(groundRoot));
	return terrainAtmosphereExit(altitude, mu);
}

vec3 terrainTransmittance(float altitude, float mu)
{
	altitude = clamp(altitude, 0.0, uAtmosphereHeight);
	mu = clamp(mu, -1.0, 1.0);
	bool ground;
	terrainAtmosphereBoundary(altitude, mu, ground);
	if(ground) return vec3(0.0);
	vec2 uv = vec2(0.5 + 0.5 * sign(mu) * sqrt(abs(mu)), sqrt(altitude / uAtmosphereHeight));
	vec2 pixel = uv * (uTransmittanceSize - 1.0);
	ivec2 low = ivec2(floor(pixel));
	ivec2 high = min(low + ivec2(1), ivec2(uTransmittanceSize) - ivec2(1));
	vec2 weight = fract(pixel);
	vec3 a = mix(texelFetch(uTransmittance, low, 0).rgb,
		texelFetch(uTransmittance, ivec2(high.x, low.y), 0).rgb, weight.x);
	vec3 b = mix(texelFetch(uTransmittance, ivec2(low.x, high.y), 0).rgb,
		texelFetch(uTransmittance, high, 0).rgb, weight.x);
	return mix(a, b, weight.y);
}

vec3 terrainSunlight(float altitude)
{
	return uSunIntensity * terrainTransmittance(altitude, uSunDirection.y);
}

vec3 terrainAtmosphereAttenuation(vec2 opticalDepth)
{
	return exp(-uRayleigh * opticalDepth.x - vec3(uMie * uHaze / uMieAlbedo * opticalDepth.y));
}

void terrainIntegrateAtmosphere(vec3 direction, float eyeAltitude, float distanceMeters, bool visibleSurface,
	out vec3 transmittance, out vec3 radiance)
{
	vec3 ray = normalize(direction);
	float altitude = clamp(eyeAltitude, 0.0, uAtmosphereHeight);
	bool ground;
	// The depth-tested terrain or water is the endpoint of a visible scene ray, including inside canyons.
	float distanceToBoundary = visibleSurface ? terrainAtmosphereExit(altitude, ray.y)
		: terrainAtmosphereBoundary(altitude, ray.y, ground);
	float stepSize = min(max(0.0, distanceMeters), distanceToBoundary) / 12.0;
	float radius = uPlanetRadius + altitude;
	float nu = clamp(dot(ray, uSunDirection), -1.0, 1.0);
	float phaseR = 3.0 * (1.0 + nu * nu) / (16.0 * TERRAIN_PI);
	float phaseM = (1.0 - uMieG * uMieG)
		/ (4.0 * TERRAIN_PI * pow(1.0 + uMieG * uMieG - 2.0 * uMieG * nu, 1.5));
	vec2 opticalDepth = vec2(0.0);
	radiance = vec3(0.0);
	for(int i = 0; i < 12; ++i)
	{
		float distanceAlong = (float(i) + 0.5) * stepSize;
		float height = terrainAtmosphereAltitude(altitude, ray.y, distanceAlong);
		vec2 density = exp(-height / vec2(uRayleighHeight, uMieHeight)) * stepSize;
		vec3 position = vec3(ray.x * distanceAlong, radius + ray.y * distanceAlong, ray.z * distanceAlong);
		float sunMu = dot(position, uSunDirection) / (uPlanetRadius + height);
		vec3 light = terrainTransmittance(height, sunMu);
		vec3 view = terrainAtmosphereAttenuation(opticalDepth + density * 0.5);
		radiance += view * light * uSunIntensity
			* (density.x * uRayleigh * phaseR + density.y * vec3(uMie * uHaze * phaseM));
		opticalDepth += density;
	}
	transmittance = terrainAtmosphereAttenuation(opticalDepth);
}

vec3 terrainSolarDisk(vec3 ray, float altitude, vec3 transmittance, float angularFootprint)
{
	bool ground;
	terrainAtmosphereBoundary(clamp(altitude,0.0,uAtmosphereHeight),ray.y,ground);
	if(ground) return vec3(0.0);
	// Chord distance avoids subtracting nearly equal cosine values at the sun's small angular radius.
	float radius = 2.0 * sin(0.5 * uAngularRadius);
	float coverage;
	if(angularFootprint <= 0.0)
		coverage = length(ray - uSunDirection) <= radius ? 1.0 : 0.0;
	else
	{
		// Convolve the disk edge with a smooth radial pixel footprint. Normalize its area so widening the
		// reflection footprint does not add solar energy. Chord radius squared equals solid angle / pi.
		float inner = max(0.0,radius - 0.5 * angularFootprint);
		float outer = radius + 0.5 * angularFootprint;
		float width = outer - inner;
		float area = inner * inner + inner * width + 0.3 * width * width;
		coverage = (1.0 - smoothstep(inner,outer,length(ray - uSunDirection))) * radius * radius / area;
	}
	return transmittance * coverage * uSunIntensity / (TERRAIN_PI * radius * radius);
}

vec3 skyRadiance(vec3 ray, float altitude, float angularFootprint, bool includeSolarDisk)
{
	ray = normalize(ray);
	vec3 transmittance;
	vec3 radiance;
	terrainIntegrateAtmosphere(ray, altitude, 1e20, false, transmittance, radiance);
	if(includeSolarDisk) radiance += terrainSolarDisk(ray,altitude,transmittance,angularFootprint);
	return radiance + terrainNightSky(ray.y);
}

vec3 skyRadiance(vec3 ray, float altitude, float angularFootprint)
{
	return skyRadiance(ray,altitude,angularFootprint,true);
}

vec3 skyRadiance(vec3 ray, float altitude)
{
	return skyRadiance(ray,altitude,0.0);
}

vec3 terrainAtmosphere(vec3 ray, float eyeAltitude, float distanceMeters, vec3 sceneLinear)
{
	vec3 transmittance;
	vec3 radiance;
	terrainIntegrateAtmosphere(ray, eyeAltitude, distanceMeters, true, transmittance, radiance);
	return mix(terrainNightSky(normalize(ray).y), max(vec3(0.0), sceneLinear), transmittance) + radiance;
}

vec3 terrainToneMap(vec3 linearColor)
{
	vec3 exposed = 1.0 - exp(-max(vec3(0.0), linearColor) * uExposure);
	return mix(12.92 * exposed, 1.055 * pow(exposed, vec3(1.0 / 2.4)) - 0.055,
		step(vec3(0.0031308), exposed));
}
